# Copy this file to `.env` and replace the placeholders with your real values.
# `.env` is gitignored — never commit real credentials.

# --- Deepslate Opal (speech-to-speech model) ---
# Vendor / organization / API key from the Deepslate platform.
# Docs: https://docs.deepslate.eu/livekit-node.md
DEEPSLATE_VENDOR_ID=your_deepslate_vendor_id
DEEPSLATE_ORGANIZATION_ID=your_deepslate_organization_id
DEEPSLATE_API_KEY=your_deepslate_api_key

# Optional: pin an Opal model. Leave unset to use the platform default
# (currently opal-v2.1).
#DEEPSLATE_MODEL=opal-v2.1

# --- Spoken output (required for audio) ---
# Opal only streams audio when a TTS backend is configured. Use EITHER a
# Deepslate-hosted (cloned) voice ...
DEEPSLATE_HOSTED_VOICE_ID=
# ... OR ElevenLabs (uncomment both lines and remove the hosted voice id).
#ELEVENLABS_API_KEY=your_elevenlabs_api_key
#ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
#ELEVENLABS_MODEL_ID=eleven_turbo_v2

# --- LiveKit (WebRTC transport / agent server) ---
# LiveKit Cloud project URL, e.g. wss://your-project.livekit.cloud
# (For a self-hosted server this is usually ws://localhost:7880)
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API key / secret pair (Cloud: Project settings -> Keys)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- Optional Opal server-side VAD tuning (leave unset for Deepslate defaults) ---
# These change WHEN Deepslate decides the user has started/stopped speaking,
# which controls barge-in latency and how quickly Opal replies.
#DEEPSLATE_VAD_START_MS=150
#DEEPSLATE_VAD_STOP_MS=390
#DEEPSLATE_VAD_CONFIDENCE=0.4
#DEEPSLATE_VAD_MIN_VOLUME=0.0
#DEEPSLATE_VAD_BACKBUFFER_MS=1000

# Explicit-dispatch name for the agent. Leave commented out for automatic
# dispatch, where the agent joins every new room in the project (simplest for
# testing). Uncomment to enable explicit dispatch: the room token must then
# request this agent name. `lk agent dev` also uses this value.
#LIVEKIT_AGENT_NAME=opal-voice-agent
