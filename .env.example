# Copy this file to `.env` and replace the placeholders with your real values.
# `.env` is gitignored — never commit real credentials.

# --- Deepslate (Opal realtime model) ---
# Vendor id, organization id, and API key from your Deepslate account.
DEEPSLATE_VENDOR_ID=your_deepslate_vendor_id_here
DEEPSLATE_ORGANIZATION_ID=your_deepslate_organization_id_here
DEEPSLATE_API_KEY=ds_your_deepslate_api_key_here

# --- Voice output (REQUIRED for audible replies) ---
# The plugin only produces audio when server-side TTS is configured.
# Pick ONE of the two options below.
#
# Option A: a voice cloned and hosted in Deepslate (no other provider needed).
#DEEPSLATE_VOICE_ID=your_hosted_voice_id_here
#DEEPSLATE_TTS_PROVIDER=hosted
# Hosted quality/latency tradeoff: high_quality (default) or low_latency.
#DEEPSLATE_TTS_MODE=high_quality
#
# Option B: ElevenLabs server-side TTS.
#ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
#ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
#ELEVENLABS_MODEL_ID=eleven_turbo_v2

# --- Optional Deepslate model settings ---
# Opal model id. Unset -> platform default (currently opal-v2.1).
# Preview model ids (e.g. opal-v3.0-preview) require access on your organization.
#DEEPSLATE_MODEL=opal-v2.1
#DEEPSLATE_BASE_URL=https://app.deepslate.eu

# --- Optional Deepslate server-side VAD tuning (leave unset for defaults) ---
# These change WHEN Deepslate decides the caller started/stopped speaking, which
# gates barge-in and reply timing. Defaults: 0.4 / 0.0 / 150 / 390 / 1000.
#DEEPSLATE_VAD_CONFIDENCE_THRESHOLD=0.4
#DEEPSLATE_VAD_MIN_VOLUME=0.0
#DEEPSLATE_VAD_START_MS=150
#DEEPSLATE_VAD_STOP_MS=390
#DEEPSLATE_VAD_BACKBUFFER_MS=1000

# --- LiveKit (WebRTC transport / agent server) ---
# LiveKit Cloud project URL, e.g. wss://your-project.livekit.cloud
# (For a self-hosted server this is usually ws://localhost:7880)
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API key / secret pair (Cloud: Project settings -> Keys)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Explicit-dispatch name for the agent. Leave commented out for automatic
# dispatch, where the agent joins every new room in the project (simplest for
# testing). Uncomment to enable explicit dispatch: the room token must then
# request this agent name. `lk agent dev` also uses this value.
#LIVEKIT_AGENT_NAME=deepslate-voice-agent
