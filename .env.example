# Copy this file to `.env` and replace the placeholders with your real values.
# `.env` is gitignored — never commit real credentials.

# --- Phonic (speech-to-speech model) ---
# Get this from the Phonic console: https://phonic.ai/ -> API keys
PHONIC_API_KEY=ph_your_phonic_api_key_here

# --- LiveKit (WebRTC transport / agent server) ---
# LiveKit Cloud project URL, e.g. wss://your-project.livekit.cloud
# (For a self-hosted server this is usually ws://localhost:7880)
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API key / secret pair (Cloud: Project settings -> Keys)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# --- Optional tuning (safe to leave unset) ---
# Phonic voice id. Documented voices: sabrina, grant, virginia, landon, eleanor, shelby, nolan
PHONIC_VOICE=sabrina

# Minimum number of user words required to interrupt the agent.
# 1 (the default) is Phonic's own default and the earliest interruption it
# supports: a single word ("stop", "wait") cuts the assistant off. Raising it
# makes the assistant keep talking over the start of every interruption, so only
# raise it if short backchannel noises ("uh", "hmm") are interrupting too often.
#PHONIC_MIN_WORDS_TO_INTERRUPT=1

# --- Optional Phonic server-side VAD tuning (leave unset for Phonic defaults) ---
# These change WHEN Phonic decides the user has started speaking, which is what
# gates the interruption. Lowering the minimum speech duration makes the agent
# stop earlier; lowering the minimum silence duration makes it reply sooner but
# can cut users off mid-thought. Tune against real recordings.
#PHONIC_VAD_PREBUFFER_MS=200
#PHONIC_VAD_MIN_SPEECH_MS=150
#PHONIC_VAD_MIN_SILENCE_MS=500
#PHONIC_VAD_THRESHOLD=0

# Explicit-dispatch name for the agent. Leave commented out for automatic
# dispatch, where the agent joins every new room in the project (simplest for
# testing). Uncomment to enable explicit dispatch: the room token must then
# request this agent name. `lk agent dev` also uses this value.
#LIVEKIT_AGENT_NAME=phonic-voice-agent
