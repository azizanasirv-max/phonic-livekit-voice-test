{
  "name": "deepslate-opal-livekit-voice-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time speech-to-speech voice agent using Deepslate Opal and LiveKit Agents (Node.js)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node src/main.ts dev",
    "start": "node src/main.ts start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "check:env": "node src/check-env.ts",
    "probe:native-sts": "node scripts/probe-native-sts.ts",
    "download-files": "livekit-agents download-files"
  },
  "dependencies": {
    "@deepslate-labs/core": "0.1.23",
    "@deepslate-labs/livekit": "0.1.23",
    "@livekit/agents": "1.9.3",
    "@livekit/rtc-node": "^1.1.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@deepslate-labs/livekit": {
      "@livekit/rtc-node": "$@livekit/rtc-node"
    }
  }
}
