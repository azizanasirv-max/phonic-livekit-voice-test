{
  "name": "phonic-livekit-voice-test",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal real-time speech-to-speech voice agent prototype using Phonic and LiveKit Agents (Node.js)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node src/main.ts dev",
    "start": "node src/main.ts start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "check:env": "node src/check-env.ts",
    "download-files": "livekit-agents download-files"
  },
  "dependencies": {
    "@livekit/agents": "1.9.3",
    "@livekit/agents-plugin-phonic": "1.9.3",
    "@livekit/rtc-node": "^1.1.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
